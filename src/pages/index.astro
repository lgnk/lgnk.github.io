---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Proofs from '../components/Proofs.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
---

<Base
  title="LGNK Sistemas · Software sob medida para pequenas e médias empresas"
  description="Arquitetamos, construímos e mantemos sistemas para pequenas e médias empresas: sistemas sob medida, apps, integrações com maquininha e Pix, sites e manutenção. Belo Horizonte, MG."
  path="/"
>
  <Hero />
  <Proofs />
  <Services />
  <section id="trabalhos" class="section"><div class="wrap"></div></section>
  <Process />
  <About />
  <Faq />
</Base>
