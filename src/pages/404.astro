---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
---

<script is:inline>
  // Sites de cliente que saíram de lgnk.com.br/<pasta>/ para <pasta>.lgnk.com.br.
  // Mantém o caminho, o ?v= do vendedor e o # do pedido.
  (function () {
    var m = location.pathname.match(/^\/(jm-atacado|silver-schuffner)(\/.*)?$/);
    if (m) location.replace("https://" + m[1] + ".lgnk.com.br" + (m[2] || "/") + location.search + location.hash);
  })();
</script>

<Base
  title="Página não encontrada · LGNK Sistemas"
  description="Essa página não existe. Volte para o início do site da LGNK Sistemas."
  path="/404/"
  noindex
>
  <section class="section not-found">
    <div class="wrap nf">
      <Mascot className="nf-cloud" />
      <div>
        <p class="label"><span aria-hidden="true">// </span>erro 404</p>
        <h1>Essa página não existe.</h1>
        <p class="nf-text">O endereço pode ter mudado ou ter um errinho de digitação. A nuvem procurou e não achou.</p>
        <a class="btn btn--primary" href="/">Voltar para o início</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 24px; align-items: center; }
  .nf :global(.nf-cloud) { width: 160px; height: 160px; }
  h1 { font-size: clamp(2.125rem, 0.6rem + 4.2vw, 3.5rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; }
  .nf-text { margin: 14px 0 26px; max-width: 46ch; font-size: var(--text-lead); color: var(--muted); }
  @media (min-width: 768px) {
    .nf { grid-template-columns: 220px 1fr; gap: 40px; }
    .nf :global(.nf-cloud) { width: 220px; height: 220px; }
  }
</style>
