---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Loader from '../components/Loader.astro';
import { clarityScriptUrl } from '../lib/clarity';
import { site } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Página fora da busca (ex.: 404): sem canonical e com robots noindex. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
// Valida o ID no build; a tag em si só é carregada no navegador depois do aceite.
if (site.clarityId) clarityScriptUrl(site.clarityId);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email.address,
  taxID: site.cnpj,
  areaServed: 'BR',
  address: { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'MG', addressCountry: 'BR' },
};
---

<!doctype html>
<html lang="pt-BR" data-clarity-id={site.clarityId || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFF8EC" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LGNK Sistemas — Menos fila, menos planilha, mais venda." />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 700 }]} />
    <Font cssVariable="--font-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Entradas das seções: liga antes da primeira pintura, para os itens já nascerem no ponto de partida.
      // Se o script das entradas (scripts/reveal.ts) não avisar em 3 s, desliga e mostra tudo parado.
      (function (html) {
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        html.classList.add('reveal-on');
        setTimeout(function () { if (!window.__lgnkReveal) html.classList.remove('reveal-on'); }, 3000);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <Loader />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script is:inline>
      // O HTML chegou inteiro: some com a nuvem de carregamento assim que as fontes estiverem prontas (no máximo 2,5 s).
      (function () {
        var loader = document.getElementById('loader');
        if (!loader) return;
        // Enquanto a nuvem está na frente, o resto da página não recebe foco nem clique.
        var behind = Array.prototype.filter.call(document.body.children, function (el) {
          return el !== loader && el.tagName !== 'SCRIPT' && el.tagName !== 'NOSCRIPT';
        });
        var gone = false;
        // Só fica inerte quando a nuvem aparece de verdade (depois de 0,4 s). Com internet boa, nada muda.
        function block() { if (!gone) behind.forEach(function (el) { el.inert = true; }); }
        if (getComputedStyle(loader).opacity !== '0') block();
        // Só a animação da própria tela conta: as da nuvem e do cursor (filhos) também disparam este evento.
        else loader.addEventListener('animationstart', function (e) { if (e.target === loader) block(); });
        function hide() {
          if (gone) return;
          gone = true;
          behind.forEach(function (el) { el.inert = false; });
          // Se a nuvem nem chegou a aparecer, sai na hora; se apareceu, fecha as persianas antes de sair.
          if (getComputedStyle(loader).opacity === '0') return loader.remove();
          loader.classList.add('loader--out');
          setTimeout(function () { loader.remove(); }, 400);
        }
        var cap = setTimeout(hide, 2500);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { clearTimeout(cap); hide(); });
        else hide();
      })();
    </script>
    <script>
      import '../scripts/reveal';
      import '../scripts/site';
    </script>
  </body>
</html>
