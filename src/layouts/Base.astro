---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Loader from '../components/Loader.astro';
import { clarityScriptUrl } from '../lib/clarity';
import { site } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  /** Página fora da busca (ex.: 404): sem canonical e com robots noindex. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
// Valida o ID no build; a tag em si só é carregada no navegador depois do aceite.
if (site.clarityId) clarityScriptUrl(site.clarityId);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  email: site.email.address,
  taxID: site.cnpj,
  areaServed: 'BR',
  address: { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'MG', addressCountry: 'BR' },
};
---

<!doctype html>
<html lang="pt-BR" data-clarity-id={site.clarityId || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFF8EC" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LGNK Sistemas — Sistemas que aguentam o dia a dia." />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 700 }]} />
    <Font cssVariable="--font-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Loader />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script is:inline>
      // O HTML chegou inteiro: some com a nuvem de carregamento assim que as fontes estiverem prontas (no máximo 2,5 s).
      (function () {
        var loader = document.getElementById('loader');
        if (!loader) return;
        var gone = false;
        function hide() {
          if (gone) return;
          gone = true;
          var visible = getComputedStyle(loader).opacity !== '0';
          loader.classList.add('loader--out');
          setTimeout(function () { loader.remove(); }, visible ? 220 : 0);
        }
        var cap = setTimeout(hide, 2500);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { clearTimeout(cap); hide(); });
        else hide();
      })();
    </script>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
