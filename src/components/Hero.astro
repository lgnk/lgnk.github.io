---
import Mascot from './Mascot.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<section id="topo" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">Sistemas que <mark>aguentam</mark> <span class="nowrap">o dia a dia.</span></h1>
      <p class="hero-sub">
        Software sob medida para pequenas e médias empresas: a gente automatiza a operação para você parar de perder venda.
      </p>
      <div class="hero-actions">
        <WhatsAppLink variant="primary" label="Conversar no WhatsApp →" />
        <a class="btn btn--alt" href="#trabalhos">Ver trabalhos</a>
      </div>
    </div>
    <div class="hero-stage" id="heroStage">
      <canvas aria-hidden="true"></canvas>
      <Mascot
        animated
        manualStart
        states={['idle', 'proc', 'done']}
        id="heroMascot"
        title="Mascote da LGNK, uma nuvem de pixels"
        className="hero-mascot"
      />
      <span class="hero-label" aria-hidden="true">esperando pedidos_</span>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero { border-bottom: var(--line); }
  .hero-grid { display: grid; padding-inline: 0; }
  .hero-copy { padding: clamp(40px, 7vw, 72px) var(--gutter) 36px; align-self: center; }
  .nowrap { white-space: nowrap; }
  .hero-title {
    font-size: clamp(40px, 6.4vw, 80px); font-weight: 800; letter-spacing: -0.045em; line-height: 0.98;
    max-width: 12ch;
  }
  .hero-sub { margin-top: 20px; max-width: 42ch; font-size: 18px; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
  .hero-stage { position: relative; height: 320px; border-top: var(--line); overflow: hidden; }
  .hero-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hero-stage[data-motion="full"] { cursor: pointer; }
  .hero-stage :global(.hero-mascot) {
    position: absolute; left: 50%; top: 46%; width: 150px; height: 150px; transform: translate(-50%, -50%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-stage :global(.hero-mascot.jump) { animation: hero-jump 0.5s steps(5) 1; }
  }
  @keyframes hero-jump {
    0%, 100% { transform: translate(-50%, -50%); }
    40% { transform: translate(-50%, -64%); }
  }
  .hero-label {
    position: absolute; left: 50%; top: calc(46% + 70px); transform: translateX(-50%);
    font: 700 12px/1 var(--font-mono); background: var(--ink); color: var(--cream); padding: 7px 9px; white-space: nowrap;
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); padding-inline: 0; }
    .hero-copy { padding-left: var(--gutter); padding-right: 40px; }
    .hero-stage { height: auto; min-height: 480px; border-top: 0; border-left: var(--line); }
    .hero-stage :global(.hero-mascot) { width: 176px; height: 176px; }
    .hero-label { top: calc(46% + 82px); }
  }
</style>
