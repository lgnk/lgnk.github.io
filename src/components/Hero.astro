---
import WhatsAppLink from './WhatsAppLink.astro';
---

<section id="topo" class="hero">
  <div class="wrap hero-grid">
    <h1 class="hero-title">Sistemas que <em class="hl">aguentam</em> <span class="nowrap">o dia a dia.</span></h1>
    <div class="hero-side">
      <p>
        Software sob medida para pequenas e médias empresas: arquitetura, desenvolvimento, integrações e manutenção.
        Do projeto ao suporte.
      </p>
      <WhatsAppLink variant="underline" label="Conversar no WhatsApp →" />
    </div>
  </div>
</section>

<style>
  .hero { border-bottom: 1px solid var(--ink); padding-block: clamp(48px, 9vw, 120px) clamp(40px, 6vw, 72px); }
  .hero-grid { display: grid; gap: 28px; }
  .nowrap { white-space: nowrap; }
  .hero-title {
    font-size: clamp(40px, 7vw, 96px); font-weight: 700; letter-spacing: -0.045em; line-height: 0.96;
    max-width: 13ch;
  }
  .hero-side { display: grid; gap: 20px; justify-items: start; max-width: 44ch; font-size: 18px; color: #2a2a2a; }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.7fr 1fr; align-items: end; gap: 48px; }
  }
</style>
