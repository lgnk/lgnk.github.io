---
import Mascot from './Mascot.astro';
---

<a href="/" class="logo" aria-label="LGNK Sistemas — início">
  <Mascot className="logo-mark" />
  <span class="logo-text">
    <span class="logo-name">lgnk</span>{' '}<span class="logo-sub">sistemas</span>
  </span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--ink); }
  .logo :global(.logo-mark) { width: 44px; height: 44px; flex: none; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-name { font-size: 27px; font-weight: 800; letter-spacing: -0.045em; }
  .logo-sub { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: var(--purple-ink); margin-top: 2px; }
</style>
