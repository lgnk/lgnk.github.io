---
import { Image, getImage } from 'astro:assets';
import Mascot from './Mascot.astro';
import { cases } from '../data/cases';

const SIZES = '(min-width: 1240px) 600px, (min-width: 900px) 50vw, calc(100vw - 32px)';
// Capa de cada vídeo: a imagem do case otimizada, carregada só no lugar do vídeo.
const posters = Object.fromEntries(
  await Promise.all(
    cases
      .filter((c) => c.media.type === 'video')
      .map(async (c) => [c.slug, (await getImage({ src: (c.media as { poster: ImageMetadata }).poster, width: 800, format: 'webp' })).src]),
  ),
);
---

<section id="trabalhos" class="section">
  <div class="wrap">
    <p class="label" data-reveal="type"><span aria-hidden="true">// </span>trabalhos</p>
    <h2 class="section-title" data-reveal="title" style="--i: 1">O que a gente já construiu.</h2>
    <ol class="cases">
      {
        cases.map((c, i) => (
          <li>
            <article class="case" data-case={c.slug}>
              <div class="case-media" data-reveal={i % 2 ? 'right' : 'left'}>
                {c.media.type === 'video' && (
                  <video
                    class="case-video"
                    data-case-video
                    muted
                    loop
                    playsinline
                    controls
                    preload="none"
                    poster={posters[c.slug]}
                    aria-label={`Vídeo de apresentação do ${c.name}`}
                  >
                    <source src={`/cases/${c.slug}/video.webm`} type="video/webm" />
                    <source src={`/cases/${c.slug}/video.mp4`} type="video/mp4" />
                  </video>
                )}
                {c.media.type === 'image' && (
                  <Image src={c.media.image} alt={c.media.alt} widths={[480, 800, 1200]} sizes={SIZES} loading="lazy" />
                )}
                {c.media.type === 'soon' && (
                  <div class="case-soon">
                    <Mascot states={['proc']} state="proc" className="soon-cloud" />
                    <span>vídeo novo em gravação…</span>
                  </div>
                )}
              </div>
              <div class="case-text" data-reveal={i % 2 ? 'left' : 'right'} style="--i: 1">
                <h3>{c.name}</h3>
                <p class="case-kind">{c.kind}</p>
                <dl class="case-story">
                  <div>
                    <dt>O problema</dt>
                    <dd>{c.problem}</dd>
                  </div>
                  <div>
                    <dt>O que construímos</dt>
                    <dd>{c.built}</dd>
                  </div>
                  <div>
                    <dt>Resultado</dt>
                    <dd>{c.result}</dd>
                  </div>
                </dl>
                <ul class="outcomes">
                  {c.outcomes.map((o) => (
                    <li>{o}</li>
                  ))}
                </ul>
                {c.href && (
                  <a class="case-link" href={c.href} target="_blank" rel="noopener noreferrer">
                    Ver site ↗<span class="sr-only"> de {c.name} (abre em nova aba)</span>
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
    <div class="work-cta" data-reveal="up">
      <p>Quer algo assim pra sua empresa?</p>
      <a class="btn btn--primary" href="#orcamento">Pedir orçamento →</a>
    </div>
  </div>
</section>

<script>
  import '../scripts/cases';
</script>

<style>
  .cases { display: grid; gap: clamp(48px, 7vw, 80px); margin-top: 44px; }
  .case { display: grid; gap: 22px; }
  .case-media { position: relative; aspect-ratio: 16 / 10; background: var(--ink); border: var(--line); box-shadow: var(--shadow); overflow: hidden; }
  .case-media :global(img), .case-video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .case-soon {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 6px;
    background: var(--cream);
  }
  .case-soon :global(.soon-cloud) { width: 120px; height: 120px; }
  .case-soon span { font: 700 var(--text-micro)/1 var(--font-mono); background: var(--ink); color: var(--cream); padding: 7px 9px; }

  .case-text h3 { font-size: clamp(1.5rem, 0.9rem + 1.6vw, 2rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .case-kind { margin-top: 6px; color: var(--muted); font-weight: 600; }
  .case-story { margin-top: 20px; display: grid; gap: 14px; }
  .case-story dt { font-size: var(--text-sm); font-weight: 800; color: var(--purple-ink); }
  .case-story dd { margin-top: 2px; max-width: 52ch; }
  .outcomes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .outcomes li { border: var(--line); background: var(--white); padding: 4px 10px; font-size: var(--text-sm); font-weight: 700; }
  .case-link {
    display: inline-flex; align-items: center; min-height: 44px; margin-top: 10px; font-weight: 700;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px;
  }
  .case-link:hover { color: var(--purple-ink); text-underline-offset: 3px; }

  .work-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: clamp(48px, 7vw, 72px); }
  .work-cta p { font-size: var(--text-lead); font-weight: 700; }

  @media (min-width: 900px) {
    .case { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
    .cases > li:nth-child(even) .case-media { order: 2; }
  }
</style>
