---
const proofs = [
  { value: '8+', label: 'modelos de maquininha integrados' },
  { value: '5,0★', label: 'nas lojas com o Avance Trainer' },
  { value: '5+ anos', label: 'construindo produtos de ponta a ponta' },
];
---

<section id="provas" class="proofs" aria-label="Números">
  <ul class="wrap proofs-grid">
    {
      proofs.map((p) => (
        <li>
          <span class="value">{p.value}</span>
          <span class="proof-label">{p.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .proofs { border-bottom: var(--line); padding-block: 28px; }
  .proofs-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  .proofs-grid li {
    display: grid; grid-template-columns: 7.5rem 1fr; align-items: baseline; gap: 12px; padding: 16px 18px;
    background: var(--white); border: var(--line); box-shadow: var(--shadow-sm);
  }
  .value { font-size: clamp(30px, 3.4vw, 40px); font-weight: 700; letter-spacing: -0.03em; white-space: nowrap; }
  .proof-label { color: var(--muted); font-size: 15px; }
  @media (min-width: 768px) {
    .proofs { padding-block: 36px; }
    .proofs-grid { grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .proofs-grid li { grid-template-columns: 1fr; gap: 4px; padding: 20px 22px; box-shadow: var(--shadow); }
  }
</style>
