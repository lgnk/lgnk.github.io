---
import { pixelIconSvg, type FaqIcon } from '../lib/icons';

const faqs: { icon: FaqIcon; q: string; a: string }[] = [
  {
    icon: 'custo',
    q: 'Quanto custa?',
    a: 'Depende do que você precisa. Depois de uma conversa rápida, você recebe a proposta com escopo, prazo e valor fechados por escrito, sem compromisso.',
  },
  { icon: 'tempo', q: 'Quanto tempo leva?', a: 'Site em semanas, sistema em meses.' },
  { icon: 'dono', q: 'O sistema fica meu?', a: 'Sim, o código e os dados são da sua empresa.' },
  {
    icon: 'caminho',
    q: 'Não sei se preciso de site, app ou sistema.',
    a: 'Normal. Conta o problema pelo WhatsApp que a gente diz o que resolve, e o que você não precisa.',
  },
  {
    icon: 'escudo',
    q: 'E se der problema depois?',
    a: 'Plano de manutenção mensal: correções, melhorias, servidor e backup, com resposta em até 1 dia útil.',
  },
];
---

<section id="perguntas" class="section">
  <div class="wrap">
    <h2 class="label" data-reveal="type"><span aria-hidden="true">// </span>perguntas frequentes</h2>
    <dl class="faq">
      {
        faqs.map((f, i) => (
          <div class="item" data-reveal="up" style={`--i: ${i % 2}`}>
            <dt>
              <Fragment set:html={pixelIconSvg(f.icon, 'faq-icon')} />
              <span>{f.q}</span>
            </dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .faq { display: grid; gap: 0 48px; margin-top: 8px; }
  .item { border-top: var(--line); padding: 18px 0 22px; }
  /* Ícone de 32 px (2 px por pixel do desenho) ao lado da pergunta; a resposta alinha com o texto. */
  dt { display: grid; grid-template-columns: 32px 1fr; gap: 14px; align-items: center; font-weight: 700; font-size: var(--text-lead); }
  dt :global(.faq-icon) { width: 32px; height: 32px; }
  dd { color: var(--muted); margin-top: 6px; padding-left: 46px; }
  @media (min-width: 768px) {
    .faq { grid-template-columns: 1fr 1fr; }
  }
</style>
