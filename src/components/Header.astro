---
import Logo from './Logo.astro';
import WhatsAppLink from './WhatsAppLink.astro';
---

<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="nav" aria-label="Principal">
      <a href="/#servicos">Serviços</a>
      <a href="/#trabalhos">Trabalhos</a>
      <a href="/#como-trabalhamos">Como trabalhamos</a>
      <a href="/#perguntas">Perguntas</a>
    </nav>
    <WhatsAppLink variant="solid" label="WhatsApp →" cta="cabecalho" />
  </div>
</header>

<style>
  .site-header { border-bottom: var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
  .nav { display: none; gap: 28px; font-size: var(--text-ui); font-weight: 600; margin-left: auto; }
  /* O sublinhado já está lá, transparente: no hover ele aparece e sobe até a palavra. */
  .nav a { text-decoration: underline 2px transparent; text-underline-offset: 9px; }
  .nav a:hover { color: var(--purple-ink); text-decoration-color: currentColor; text-underline-offset: 5px; }
  @media (min-width: 768px) {
    .nav { display: flex; }
  }
</style>
