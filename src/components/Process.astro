---
import { pixelIconSvg, type ProcessIcon } from '../lib/icons';

const steps: { icon: ProcessIcon; title: string; text: string }[] = [
  { icon: 'conversa', title: 'Conversa', text: 'Pelo WhatsApp, sem compromisso. Você conta o problema, a gente pergunta o resto.' },
  { icon: 'proposta', title: 'Diagnóstico e proposta', text: 'Escopo, prazo e valor fechados por escrito.' },
  { icon: 'construcao', title: 'Construção', text: 'Entregas toda semana: você acompanha e testa.' },
  { icon: 'entrega', title: 'Entrega e cuidado', text: 'Treinamento na entrega. Depois, o plano de manutenção mensal.' },
];
---

<section id="como-trabalhamos" class="section">
  <div class="wrap">
    <p class="label" data-reveal="type"><span aria-hidden="true">// </span>processo</p>
    <h2 class="section-title" data-reveal="title" style="--i: 1">Sem surpresa no meio do caminho.</h2>
    <ol class="grid4">
      {
        steps.map((s, i) => (
          <li data-reveal="left" style={`--i: ${i}`}>
            <Fragment set:html={pixelIconSvg(s.icon)} />
            <h3><span class="num">{i + 1}</span> {s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
