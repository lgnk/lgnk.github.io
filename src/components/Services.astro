---
import { pixelIconSvg, type ServiceIcon } from '../lib/icons';

const services: { icon: ServiceIcon; title: string; text: string }[] = [
  {
    icon: 'sistema',
    title: 'Sistema sob medida',
    text: 'Pedidos, estoque, agenda e financeiro num lugar só, do jeito que a sua empresa já trabalha. Chega de planilha.',
  },
  {
    icon: 'maquininha',
    title: 'App e maquininha',
    text: 'Seu cliente compra pelo celular e paga na maquininha ou no Pix. A gente integra com Stone, PagBank e Mercado Pago.',
  },
  {
    icon: 'loja',
    title: 'Site e loja virtual',
    text: 'Vitrine, catálogo ou loja com pedido direto no WhatsApp. O jeito mais rápido de começar com a gente.',
  },
  {
    icon: 'manutencao',
    title: 'Manutenção',
    text: 'Correções, melhorias, servidor e backup todo mês. Deu problema, a gente responde em até 1 dia útil.',
  },
];
---

<section id="servicos" class="section">
  <div class="wrap">
    <p class="label" data-reveal="type"><span aria-hidden="true">// </span>o que fazemos</p>
    <h2 class="section-title" data-reveal="title" style="--i: 1">O que a gente resolve.</h2>
    <ul class="grid4">
      {
        services.map((s, i) => (
          <li data-reveal="pop" style={`--i: ${i}`}>
            <Fragment set:html={pixelIconSvg(s.icon, 'service-icon')} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="unsure" data-reveal="up">
      <p>Não sabe se precisa de site, app ou sistema? Conta o problema que a gente diz o que resolve.</p>
      <a class="btn btn--alt" href="#orcamento">Montar meu orçamento →</a>
    </div>
  </div>
</section>

<style>
  .unsure { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 32px; }
  .unsure p { font-size: var(--text-lead); font-weight: 700; max-width: 46ch; }
</style>

