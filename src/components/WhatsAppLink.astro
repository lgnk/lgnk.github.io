---
import { site } from '../config';
import { whatsappUrl } from '../lib/whatsapp';

interface Props {
  label: string;
  /** solid: cabeçalho (pequeno, roxo) · primary: topo (grande, roxo) · footer: rodapé (amarelo) */
  variant: 'solid' | 'primary' | 'footer';
  /** Onde o botão está, para o Clarity saber qual chamada converte. */
  cta: string;
}

const { label, variant, cta } = Astro.props;
const href = whatsappUrl(site.whatsapp.number, site.whatsapp.message);
const classes = {
  solid: 'btn btn--primary btn--sm',
  primary: 'btn btn--primary',
  footer: 'btn btn--alt',
}[variant];
---

<a data-whatsapp data-cta={cta} href={href} target="_blank" rel="noopener noreferrer" class:list={['wa', classes]}>
  {label}<span class="sr-only"> (abre o WhatsApp em nova aba)</span>
</a>
